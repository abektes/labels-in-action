{
	"name": "fichero-app",
	"private": true,
	"type": "module",
	"version": "0.1.0",
	"scripts": {
		"dev": "vite --port 5199 --strictPort",
		"build": "vite build",
		"preview": "vite preview --port 5200 --strictPort",
